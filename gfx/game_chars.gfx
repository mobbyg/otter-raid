; ===================================================================
; Land $08-$0F.  $08 = CH_LAND base grass (also the fill used by the
; generated bank edges and stamp backgrounds).  Kept flat so large
; fields are calm; $09-$0F are the sprinkled variants.
;   $08 LAND  $09 tuft  $0A tuft (small)  $0B flower  $0C two flowers
;   $0D pebbles  $0E bare earth  $0F clover/dark grass
; ===================================================================
@chars at=$08 names=LAND,LAND_TUFT,LAND_TUFT2,LAND_FLOWER,LAND_FLOWERS,LAND_PEBBLES,LAND_DIRT,LAND_CLOVER
gggg gggg gggg gggg gggg gggg gggg gggg
gggg gggg gggg gggg gggg gggg gggg gggg
gggg gbgg gggg gwgg gggg gggg gggg gggg
gggg bgbg gggb wbwg gggw gggg ggbg gggg
gggg gbgb ggbg gwgg ggbg gwbg gbbb gbgg
gggg gggg gggg gbgg wggg gbbg ggbg bgbg
gggg gggg gggg gggg bggg gggg gggg gbgg
gggg gggg gggg gggg gggg gggg gggg gggg

; ===================================================================
; Crawfish pickup $50-$51 (2x1 chars, on water).  4 frames: claws
; snap, tail flicks, the light-blue sparkle twinkles around it.
; ===================================================================
@crawfish frame=0      ; pincers open, lit rim along the top
.ww.....
wbbw...w
.wbbww.b
..wbbbwb
...bbbbb
...bbb.b
.bbb...b
bbb.....

@crawfish frame=1      ; pincers snap shut
........
.wwww..w
wbbbbbwb
..wbbbwb
...bbbbb
..bbbb.b
.bbb...b
........

@crawfish frame=2      ; open again, tail flicks, sparkle moves
.ww.....
wbbw....
.wbbww.w
..wbbbwb
w..bbbbb
...bbbbb
.bbb...b
bbb.....

@crawfish frame=3      ; snap, sparkle bottom-right
........
.wwww...
wbbbbbwb
..wbbbwb
...bbbbb
w.bbbb.b
.bbb...b
.......w

; ===================================================================
; Pickup "pop" effect $52-$57: three 2x1 frames of an expanding ring
; for the engine to show where a crawfish was collected.
; ===================================================================
@chars at=$52 names=POP0_L,POP0_R,POP1_L,POP1_R,POP2_L,POP2_R
........ ........ ........
........ ...ww... ..w..w..
...ww... ..w..w.. .w....w.
..w..w.. .w....w. w......w
..w..w.. .w....w. w......w
...ww... ..w..w.. .w....w.
........ ...ww... ..w..w..
........ ........ ........

; ===================================================================
; Fish pickup $58-$59 (Ollie's snack, restores Life Points), on water.
; Silver body (w), green fins/lateral line, brown eye.  4 frames of
; tail flick; the engine copies frame k over $58-$59 on the crawfish
; timer.
; ===================================================================
@fish frame=0          ; tail straight
........
..wwww.g
.bwwwwgg
wwwwwwg.
.wggggwg
..wwww.g
...g....
........

@fish frame=1          ; tail flicks up
......gg
..wwwwg.
.bwwwwg.
wwwwwwg.
.wggggw.
..wwww..
...g....
........

@fish frame=2          ; tail straight
........
..wwww.g
.bwwwwgg
wwwwwwg.
.wggggwg
..wwww.g
...g....
........

@fish frame=3          ; tail flicks down
........
..wwww..
.bwwwwg.
wwwwwwg.
.wggggwg
..wwww.g
...g...g
........

; ===================================================================
; Gifts for Auntie $5A-$5F, three 2x1 pickups floating on water:
;   $5A/$5B GIFT0 water-lily blossom   $5C/$5D GIFT1 birthday cake
;   $5E/$5F GIFT2 wrapped gift box
; 2-frame shimmer (sparkle / flickering candles), 48 bytes per frame.
; ===================================================================
@gifts frame=0
...ww... ...w.w.. .ww..ww.
.ww..ww. ...g.g.. w.wwww.w
.wwwwww. .wwwwwww .ggwwgg.
gwwbbwwg wgwwbwgw .ggwwgg.
gwwbbwwg bbbbbbbb .wwwwww.
.wwwwww. wwwwwwww .ggwwgg.
.ww..ww. bbbbbbbb .ggwwgg.
...ww... .bbbbbb. ..bbbb..

@gifts frame=1
.w.ww... w..w.w.. .ww..ww.
.ww..ww. ...g.g.. w.wwww.w
.wwwwww. .wwwwwww .ggwwggw
gwwbbwwg wwgwbwwg .ggwwgg.
gwwbbwwg bbbbbbbb .wwwwww.
.wwwwww. wwwwwwww .ggwwgg.
.ww..ww. bbbbbbbb .ggwwgg.
...ww.w. .bbbbbb. w.bbbb..
